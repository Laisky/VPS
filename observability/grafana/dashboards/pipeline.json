{
  "uid": "obs-pipeline", "title": "one-api / Telemetry pipeline", "schemaVersion": 39,
  "version": 1, "timezone": "utc", "refresh": "15s", "time": {"from": "now-1h", "to": "now"},
  "tags": ["one-api", "observability"],
  "panels": [
    {"id": 1, "type": "stat", "title": "Gateway and storage reachability", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "obs-metrics"}, "targets": [{"refId": "A", "expr": "up", "legendFormat": "{{job}}"}]},
    {"id": 2, "type": "timeseries", "title": "Gateway exporter queue occupancy", "description": "A growing queue means backend delivery lags admission. These are exporter queue units, not final storage receipts.", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "obs-metrics"}, "targets": [{"refId": "A", "expr": "otelcol_exporter_queue_size", "legendFormat": "{{exporter}}"}]},
    {"id": 3, "type": "timeseries", "title": "Telemetry process RSS", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "obs-metrics"}, "fieldConfig": {"defaults": {"unit": "bytes"}}, "targets": [{"refId": "A", "expr": "process_resident_memory_bytes", "legendFormat": "{{job}}"}]},
    {"id": 4, "type": "logs", "title": "one-api logs — expand a record to open its trace", "gridPos": {"x": 0, "y": 12, "w": 24, "h": 12}, "datasource": {"type": "victoriametrics-logs-datasource", "uid": "obs-logs"}, "targets": [{"refId": "A", "expr": "{service.name=\"one-api\"}", "queryType": "instant", "editorMode": "code", "maxLines": 1000}], "options": {"showTime": true, "showLabels": false, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 5, "type": "text", "title": "Diagnosis and scope", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 7}, "options": {"mode": "markdown", "content": "Use **Explore → Logs** for LogsQL and **Explore → Traces** for Jaeger trace lookup.\n\nThis dashboard is operational telemetry, not the billing ledger. Missing data is not zero traffic. A home outage requires an independent b1/external alert. Default retention is seven days; physical reclamation is asynchronous. See the deployment runbook for disk and queue checks."}}
  ]
}
