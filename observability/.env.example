# Copy to .env with mode 0600; replace every placeholder. Do not commit secrets.
GO_FLUENTD_IMAGE=go-fluentd:reviewed-commit
OBS_UID=1000
OBS_GID=1000
EDGE_BIND=100.122.41.16
HOME_BIND=100.69.166.78
EDGE_TOKEN=replace-with-a-unique-64-character-random-hex-token
HOME_TOKEN=replace-with-a-different-64-character-random-hex-token
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-long-password
# Point these at provisioned, owned, dedicated storage, not the OS/one-api disk.
EDGE_STATE=/var/lib/observability/edge
HOME_STATE=/var/lib/observability/home
